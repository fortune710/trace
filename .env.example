# Docker Compose local-development configuration. Copy to .env before starting.
# These values are intentionally local-only placeholders; never commit a real .env file.

POSTGRES_PASSWORD=change-me-for-local-development
TRACE_APP_PASSWORD=change-me-for-local-app-access
TRACE_INTERNAL_PASSWORD=change-me-for-local-internal-worker-access
TRACE_CREDENTIAL_MAINTENANCE_PASSWORD=change-me-for-local-credential-maintenance-access
MIGRATION_DATABASE_URL=postgresql://trace:change-me-for-local-development@postgres:5432/trace
DATABASE_URL=postgresql://trace_app:change-me-for-local-app-access@postgres:5432/trace
INTERNAL_DATABASE_URL=postgresql://trace_internal:change-me-for-local-internal-worker-access@postgres:5432/trace
MAINTENANCE_DATABASE_URL=postgresql://trace_credential_maintenance:change-me-for-local-credential-maintenance-access@postgres:5432/trace
TEST_POSTGRES_PASSWORD=change-me-for-local-test-database
TEST_TRACE_APP_PASSWORD=change-me-for-local-test-app-access
TEST_TRACE_INTERNAL_PASSWORD=change-me-for-local-test-internal-worker-access
TEST_TRACE_CREDENTIAL_MAINTENANCE_PASSWORD=change-me-for-local-test-credential-maintenance-access
TEST_MIGRATION_DATABASE_URL=postgresql://trace:change-me-for-local-test-database@postgres-test:5432/trace_test
TEST_DATABASE_URL=postgresql://trace_app:change-me-for-local-test-app-access@postgres-test:5432/trace_test
TEST_INTERNAL_DATABASE_URL=postgresql://trace_internal:change-me-for-local-test-internal-worker-access@postgres-test:5432/trace_test
TEST_MAINTENANCE_DATABASE_URL=postgresql://trace_credential_maintenance:change-me-for-local-test-credential-maintenance-access@postgres-test:5432/trace_test
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
RABBITMQ_USER=trace_queue
RABBITMQ_PASSWORD=change-me-for-local-rabbitmq
AUTH_RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2F

# Authentication. Generate each required AUTH_*_KEY value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Do not commit the generated values.
AUTH_ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE_NAME=trace_access
AUTH_REFRESH_COOKIE_NAME=trace_refresh
AUTH_CSRF_COOKIE_NAME=trace_csrf
AUTH_COOKIE_SAME_SITE=lax
AUTH_JWT_ISSUER=http://localhost:8000
AUTH_JWT_AUDIENCE=trace-api
AUTH_JWT_KID=local-v1
AUTH_JWT_PRIVATE_KEY=
# JSON map of retired key IDs to base64url Ed25519 public keys during key rotation.
AUTH_JWT_VERIFICATION_KEYS={}
AUTH_TOKEN_HASH_KEY=
# The Compose stack uses Vault Transit by default. This legacy local AES key is
# required only when AUTH_CREDENTIAL_ENCRYPTION_PROVIDER=local.
AUTH_CREDENTIAL_ENCRYPTION_KEY=
AUTH_CREDENTIAL_ENCRYPTION_KEY_VERSION=local-v1
# JSON map of retired local credential-key versions to base64url keys during rotation.
AUTH_CREDENTIAL_ENCRYPTION_VERIFICATION_KEYS={}
AUTH_CREDENTIAL_ENCRYPTION_PROVIDER=vault
# Development-only Vault root token. It is used only to bootstrap a restricted
# backend token inside the private Compose network; do not reuse it on a server.
VAULT_DEV_ROOT_TOKEN_ID=replace-with-a-distinct-local-vault-root-token
AUTH_VAULT_ADDR=http://vault:8200
AUTH_VAULT_TRANSIT_MOUNT=transit
AUTH_VAULT_TRANSIT_KEY=trace-provider-credentials
AUTH_VAULT_EMAIL_TRANSIT_KEY=trace-email-delivery
AUTH_VAULT_REQUEST_TIMEOUT_SECONDS=3
AUTH_VAULT_TOKEN_RENEWAL_SECONDS=300
AUTH_CSRF_HMAC_KEY=
AUTH_AUDIT_HASH_KEY=
AUTH_ALLOWED_ORIGINS=["http://localhost:5173"]
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_EMAIL_FROM="Trace <no-reply@trace.local>"
AUTH_EMAIL_MAX_RETRIES=3
AUTH_EMAIL_RETRY_DELAYS_SECONDS=[30,300,1800]
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=http://localhost:8000/auth/oauth/github/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
