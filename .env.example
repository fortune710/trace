# Docker Compose local-development configuration. Copy to .env before starting.
# These values are intentionally local-only placeholders; never commit a real .env file.

POSTGRES_PASSWORD=change-me-for-local-development
TRACE_APP_PASSWORD=change-me-for-local-app-access
MIGRATION_DATABASE_URL=postgresql://trace:change-me-for-local-development@postgres:5432/trace
DATABASE_URL=postgresql://trace_app:change-me-for-local-app-access@postgres:5432/trace
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025

# Reserved for later authentication phases. Generate real values before use.
SESSION_SECRET=replace-before-implementing-authentication
CREDENTIAL_ENCRYPTION_KEY=replace-before-implementing-credential-storage
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
